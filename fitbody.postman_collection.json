{
  "info": {
    "name": "FitBody BE",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token",   "value": "" },
    { "key": "memberId","value": "" },
    { "key": "feeId",   "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fitbody.com\",\n  \"password\": \"Admin@123456\"\n}"
            }
          }
        },
        {
          "name": "Admin Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Get All Members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/members?page=1&limit=20",
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "limit",    "value": "20" },
                { "key": "search",   "value": "", "disabled": true },
                { "key": "isActive", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Member by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/members/{{memberId}}"
          }
        },
        {
          "name": "Create Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.member && res.member._id) {",
                  "  pm.collectionVariables.set('memberId', res.member._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ali\",\n  \"lastName\": \"Khan\",\n  \"phone\": \"03001234567\",\n  \"cnic\": \"42101-1234567-1\",\n  \"gender\": \"male\",\n  \"age\": 25,\n  \"weight\": 75,\n  \"fees\": 3000,\n  \"feesAfterDiscount\": 2500\n}"
            }
          }
        },
        {
          "name": "Update Member",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/members/{{memberId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 78,\n  \"feesAfterDiscount\": 2200\n}"
            }
          }
        },
        {
          "name": "Delete Member",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/members/{{memberId}}"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/attendance",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": \"{{memberId}}\",\n  \"status\": \"present\",\n  \"date\": \"2026-05-22\"\n}"
            }
          }
        },
        {
          "name": "Get All Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/attendance?date=2026-05-22",
              "query": [
                { "key": "date",      "value": "2026-05-22" },
                { "key": "memberId",  "value": "", "disabled": true },
                { "key": "startDate", "value": "", "disabled": true },
                { "key": "endDate",   "value": "", "disabled": true },
                { "key": "page",      "value": "1", "disabled": true },
                { "key": "limit",     "value": "50", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Member Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/attendance/member/{{memberId}}?month=5&year=2026",
              "query": [
                { "key": "month", "value": "5" },
                { "key": "year",  "value": "2026" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Fees",
      "item": [
        {
          "name": "Create Fee Record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.fee && res.fee._id) {",
                  "  pm.collectionVariables.set('feeId', res.fee._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fees",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": \"{{memberId}}\",\n  \"amount\": 2500,\n  \"dueDate\": \"2026-06-01\"\n}"
            }
          }
        },
        {
          "name": "Get All Fees",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/fees",
              "query": [
                { "key": "status",   "value": "unpaid", "disabled": true },
                { "key": "memberId", "value": "", "disabled": true },
                { "key": "page",     "value": "1", "disabled": true },
                { "key": "limit",    "value": "20", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Member Fees",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/fees/member/{{memberId}}"
          }
        },
        {
          "name": "Collect Fee (Mark Paid)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fees/{{feeId}}/collect",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"cash\",\n  \"note\": \"Paid at front desk\"\n}"
            }
          }
        },
        {
          "name": "Update Fee Record",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fees/{{feeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2200,\n  \"dueDate\": \"2026-06-15\",\n  \"status\": \"overdue\"\n}"
            }
          }
        },
        {
          "name": "Delete Fee Record",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/fees/{{feeId}}"
          }
        }
      ]
    }
  ]
}
